# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# temporary scrape/debug artifacts (images, HTML challenges, etc.)
.tmp*/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Facebook OG crops generated by scripts/optimize-event-images.mjs at build.
/public/og/events/

# MapLibre GL worker copied by scripts/copy-maplibre-worker.mjs (dev/build).
/public/maplibre-gl-worker.mjs

# Local Netlify folder
.netlify

# Local-only push/reminder store for `next dev` without Firebase
.data/

# Marketing outreach — personal IG exports and local scripts (keep venue CSV/queue in repo)
marketing/outreach/__pycache__/
marketing/outreach/ig-followers.txt
marketing/outreach/instagram-export-*/
