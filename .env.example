# OpenAI — structures raw crawled content into clean event cards
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Brave Search — optional web search for ingest (~$5/mo free credits ≈ 1k queries)
# Sign up: https://api-dashboard.search.brave.com/ → Search plan → Add API key
# Test locally: BRAVE_SEARCH_API_KEY=your-key node scripts/test-brave-search.mjs
BRAVE_SEARCH_API_KEY=

# Google Analytics — track page views and user behavior (free)
# 1. Go to https://analytics.google.com/
# 2. Create a new GA4 property for your site
# 3. Copy the Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — site ownership verification (free)
# 1. Go to https://search.google.com/search-console
# 2. Add property https://pop-event.com → choose "HTML tag" verification
# 3. Copy only the content value from the meta tag (not the full tag)
# See SEARCH_CONSOLE_SETUP.md for full indexing steps
GOOGLE_SITE_VERIFICATION=

# Firebase — persistent events, venues, push subscriptions (Spark/free tier)
# See firebase/README.md for setup
# Option A: paste full service account JSON (easiest on Netlify)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: separate fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Web Push (VAPID) — weekend digest notifications
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Weekend newsletter (Resend free tier — 3,000 emails/month, 100/day)
# 1. Sign up at https://resend.com (no credit card for the free tier)
# 2. Add and verify pop-event.com → create an API key
# 3. Set from to a verified address, e.g. POP Events <updates@pop-event.com>
# Friday GitHub Action POSTs /api/cron/newsletter when CRON_SECRET is set.
# Signups still store in Firebase without these vars; sending is skipped.
RESEND_API_KEY=
RESEND_FROM=

# Canonical site URL for share links and Open Graph (defaults to https://pop-event.com)
NEXT_PUBLIC_SITE_URL=https://pop-event.com

# Donations (PayPal lite) — support page + nudge. Defaults to paypal.me/asemota if unset.
NEXT_PUBLIC_DONATE_EXTERNAL_URL=https://paypal.me/asemota

# Moderation & cron ingest/notify endpoints
# Authenticate with: Authorization: Bearer <secret>  (query ?secret= is rejected)
MODERATOR_SECRET=
CRON_SECRET=

# Meta Graph — post to the POP Events Facebook Page + linked Instagram
# Setup: https://developers.facebook.com/apps → create app → add Instagram + pages
# Graph API Explorer: pages_show_list, pages_manage_posts,
#   instagram_basic, instagram_content_publish (app admin can post without App Review)
# Do not grant pages_read_engagement / ads / insights — those trip Meta's Insights call-load limit.
# Exchange short-lived user token → long-lived → GET /me/accounts for Page token
# GET /{page-id}?fields=instagram_business_account  → META_INSTAGRAM_ACCOUNT_ID
# POST /api/cron/meta-post  Authorization: Bearer CRON_SECRET
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
# META_GRAPH_VERSION=v22.0

# Venue assessments — editorial snapshots on venue pages only
# Set to false/0/off to hide. Prefer NEXT_PUBLIC_ so client can hide too.
NEXT_PUBLIC_VENUE_ASSESSMENTS_ENABLED=true
VENUE_ASSESSMENTS_ENABLED=true
# Event opinions — unique researched takes (never copy venue tips onto events)
NEXT_PUBLIC_EVENT_OPINIONS_ENABLED=true
EVENT_OPINIONS_ENABLED=true

# Temporary special / featured event (local preview without editing SPECIAL_EVENTS)
# NEXT_PUBLIC_SPECIAL_EVENT_ID=sunset-night-party-playa-encuentro-2026-07-25
# NEXT_PUBLIC_SPECIAL_EVENT_CITY=cabarete
# Optional Google Places API (New) key — overlays rating + review sentiment on venue tips
# Also powers Places → event-opinion draft pipeline (cron; approve before live)
# Enable Places API (New) in Google Cloud; leave empty for editorial-only
GOOGLE_PLACES_API_KEY=

# Browser Maps JavaScript API key — in-app Street View modal on venue pages
# Enable Maps JavaScript API; restrict key HTTP referrers to pop-event.com + localhost
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Opinion drafts: GET/POST /api/cron/event-opinion-drafts?generate=1
#   Header: Authorization: Bearer CRON_SECRET
# Approve: ?approve=eventId  Reject: ?reject=eventId
# Approved drafts (with Google ★ rating) appear on events via /api/events/[id]/opinion
