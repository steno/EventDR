rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Client SDK is not used for writes — Admin SDK in API routes bypasses rules.
    // Public client reads are limited to approved catalog data only.

    match /venues/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /events/{id} {
      allow read: if resource.data.status == 'approved';
      allow write: if false;
    }

    // Ops / PII collections — Admin only (explicit deny for clarity).
    match /pushSubscriptions/{id} {
      allow read, write: if false;
    }

    match /partnerDigestSubscribers/{id} {
      allow read, write: if false;
    }

    match /eventOpinionDrafts/{id} {
      allow read, write: if false;
    }

    match /ops/{id} {
      allow read, write: if false;
    }

    // Deny-by-default for any other collection or nested path.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
